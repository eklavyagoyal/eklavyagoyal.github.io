{
  "name": "eklavyagoyal-website",
  "version": "2.0.0",
  "description": "Eklavya Goyal's personal website - Modern Hugo site with TailwindCSS",
  "private": true,
  "scripts": {
    "dev": "hugo server -D --disableFastRender",
    "build": "hugo --minify",
    "build:prod": "NODE_ENV=production hugo --minify --gc",
    "lighthouse": "lhci autorun",
    "clean": "rm -rf public resources",
    "deploy": "npm run build:prod && gh-pages -d public"
  },
  "keywords": [
    "hugo",
    "personal-website",
    "physics",
    "machine-learning",
    "teaching"
  ],
  "author": "Eklavya Goyal",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0"
  },
  "optionalDependencies": {
    "@lhci/cli": "^0.13.0",
    "gh-pages": "^6.1.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

